{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfhealthcareVishal"
		},
		"LS_AzureSqlDatabase1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSqlDatabase1'"
		},
		"LS_Dst_AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_Dst_AzureDataLakeStorage1'"
		},
		"LS_Src_AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_Src_AzureDataLakeStorage1'"
		},
		"ls_datalake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_datalake'"
		},
		"LS_AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "intellibisqlbd.database.windows.net"
		},
		"LS_AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "ASQL_MI_DB"
		},
		"LS_AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"LS_Dst_AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://azstorageacct9768085663.dfs.core.windows.net/"
		},
		"LS_Src_AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://azstorageacct9768085663.dfs.core.windows.net/"
		},
		"ls_datalake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://azstorageacct9768085663.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfhealthcareVishal_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AzureSqlDatabase1_password": {
						"value": "[parameters('LS_AzureSqlDatabase1_password')]"
					},
					"LS_Dst_AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('LS_Dst_AzureDataLakeStorage1_accountKey')]"
					},
					"LS_Src_AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('LS_Src_AzureDataLakeStorage1_accountKey')]"
					},
					"ls_datalake_accountKey": {
						"value": "[parameters('ls_datalake_accountKey')]"
					},
					"LS_AzureSqlDatabase1_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSqlDatabase1_properties_typeProperties_server')]"
					},
					"LS_AzureSqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSqlDatabase1_properties_typeProperties_database')]"
					},
					"LS_AzureSqlDatabase1_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSqlDatabase1_properties_typeProperties_userName')]"
					},
					"LS_Dst_AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('LS_Dst_AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"LS_Src_AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('LS_Src_AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"ls_datalake_properties_typeProperties_url": {
						"value": "[parameters('ls_datalake_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}